DB_HOST=172.20.21.50
DB_PORT=1433
DB_NAME=QAIntouch
DB_USER=CHANGEME
DB_PASSWORD=CHANGEME
DB_SCHEMA=intouch
# Segundos que se reusa una conexion a SQL Server antes de reciclarla. Sin esto
# Django abre una conexion NUEVA por request, y el handshake contra el servidor
# de QA medido el 2026-09-02 iba de 0,5s a 36s (docs/PENDIENTES.md #17).
DB_CONN_MAX_AGE=600
DB_DRIVER=ODBC Driver 18 for SQL Server
QAINTOUCH_DB_NAME=QAIntouch

GRANCRM_JWT_SECRET=CHANGEME
DIOS_URL=http://orquestador:9000
DIOS_CONFIG_PATH=/app/dios.json

WHATSAPP_TOKEN=CHANGEME
WHATSAPP_PHONE_ID=CHANGEME
WHATSAPP_VERIFY_TOKEN=CHANGEME
WHATSAPP_APP_SECRET=CHANGEME
WHATSAPP_BUSINESS_ACCOUNT_ID=CHANGEME
PUBLIC_BASE_URL=https://qadash.in-touchcrm.cl/wsp/intouch
# Plantillas de Meta -- ver "demo cavem/PLANTILLAS_META_CAVEM.md" para el
# contenido exacto a dar de alta. Crearlas en idioma "es", NO "es_CL": el
# cliente manda code="es" y con es_CL Meta responde 132001.
# El nombre de la plantilla de seguimiento se configura desde el panel
# (Setting "seguimiento_vehiculo_template"), no aca.

# GOOGLE_API_KEY: solo los embeddings del RAG (gemini-embedding-2, OpenRouter
# no ofrece endpoint de embeddings).
GOOGLE_API_KEY=CHANGEME

# Todo el LLM va por OpenRouter: conversacional (bot/flow/graph.py) y
# percepcion de medios (bot/flow/media_processing.py) desde el 2026-08-19, y
# extraccion de scraping/documentos (bot/scraping/extractor.py) desde el
# 2026-09-02 -- antes usaba la API directa de DeepSeek y esa cuenta se quedo
# sin saldo justo al indexar el RAG de Cavem. Una sola key, un solo saldo.
OPENROUTER_API_KEY=CHANGEME
OPENROUTER_MODEL=~deepseek/deepseek-v4-flash-latest
OPENROUTER_MEDIA_MODEL=google/gemini-3.7-flash
OPENROUTER_SCRAPING_MODEL=~deepseek/deepseek-v4-flash-latest
# Ruteo (classify-intent). Modelo chico a proposito: elegir entre ~5 slugs no
# necesita un MoE de 284B. Medido 2026-09-02 sobre el contenedor real: el
# modelo conversacional daba mediana 2,78s y MAXIMO 62,40s en esa llamada;
# este da mediana 0,71s y maximo 1,07s, con el mismo acierto de ruteo.
OPENROUTER_ROUTING_MODEL=ibm-granite/granite-4.2-8b
OPENROUTER_ROUTING_MAX_TOKENS=200
# Proveedores del modelo conversacional, en orden de preferencia. NO ordenar por
# latencia: eso ordena por time-to-first-token y elegia un proveedor de 14
# tokens/s, o sea 40-60s por turno (auditoria 2026-09-02, docs/PENDIENTES.md
# #14). Los tres son fp8 o mejor a proposito -- los fp4 se descartaron para no
# arriesgar la calidad de redaccion.
OPENROUTER_PROVIDER_ORDER=Baidu,CoreWeave,DeepSeek

# RAG agentico (bot/rag/) -- schema propio dentro del proyecto Supabase
# `intouch`, creado con `scripts/rag_schema_para.sh <cliente>` y expuesto en
# Settings -> API -> Exposed schemas. Ver docs/DEPLOY_CAVEM.md seccion 1.
SUPABASE_URL=CHANGEME
SUPABASE_KEY=CHANGEME

# Schema de Postgres (dentro del mismo proyecto Supabase) que usa esta marca --
# ver docs/superpowers/specs/2026-08-25-rag-hibrido-rerank-multimarca-design.md.
# Cada marca nueva crea su propio schema (bot/rag/schema.sql) y su contenedor
# apunta aca con su nombre -- nunca cambia por request.
RAG_SCHEMA=intouch

# Cliente activo del lado Django -- controla que filas devuelven los managers
# de bot/models.py (VehiculoCatalogo, Sucursal, Servicio, ScrapingSource,
# PromptVersion, CustomSpecialist), equivalente a RAG_SCHEMA pero para la BD
# relacional en vez del contenido RAG en Supabase. Debe ser uno de
# bot.models.CLIENTE_CHOICES o el arranque falla (system check bot.E001).
CLIENTE_ACTIVO=intouch

# Trazabilidad de las llamadas al LLM (bot/flow/graph.py y bot/scraping/extractor.py).
# Crear proyecto en https://cloud.langfuse.com y copiar sus API keys aca.
LANGFUSE_PUBLIC_KEY=CHANGEME
LANGFUSE_SECRET_KEY=CHANGEME
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# production/staging/qa/development -- separa las trazas por ambiente en el
# mismo proyecto Langfuse (ver https://langfuse.com/docs/observability/features/environments)
LANGFUSE_TRACING_ENVIRONMENT=development

USE_SQLITE=false
DEBUG=false

# Cuenta de GranCRM a la que se notifican los leads HOT (bot/notify.py).
GRANCRM_TENANT_SLUG=CHANGEME

# Destino externo del lead. "none" hasta que exista POST /api/leads en el
# orquestador; entonces "http" y LEAD_SINK_URL con su endpoint. La tabla propia
# (LeadInTouch) se escribe SIEMPRE, es la fuente de verdad.
# Con LEAD_SINK=http: el endpoint del CRM y su secreto de ingesta dedicado
# (NO una API key del framework de autenticación del CRM). La URL se resuelve
# desde la red del contenedor (crm_ingest), no desde el host.
LEAD_SINK=none
LEAD_SINK_URL=
LEAD_SINK_TOKEN=
